generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// SQL Server connector doesn't support native enums — Role/RunStatus are
// plain strings, validated at the application layer (see src/lib/rbac.ts).
// Role: "ADMIN" | "SPECIALIST" | "STORE"
// RunStatus: "NOT_STARTED" | "IN_PROGRESS" | "DONE" | "ABANDONED"

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("STORE")
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  runs            PlanogramRun[]
  imports         Planogram[]    @relation("ImportedBy")
  feedbacks       Feedback[]     @relation("FeedbackAuthor")
  feedbackReplies Feedback[]     @relation("FeedbackReplier")
}

model Store {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String?
  chain     String?
  format    String?
  address   String?
  email     String?
  createdAt DateTime @default(now())

  users      User[]
  planograms Planogram[]
  printers   Printer[]
}

// A store can have several printers (till, warehouse, ...), so IPs live in
// their own table rather than a single Store.printerIp field.
model Printer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  name      String?
  ip        String
  tray      String?
  createdAt DateTime @default(now())

  @@index([storeId])
}

// Top-level product department (Бакалея, Напитки, ...). `nodePrefix` is a
// fallback bucket rule (e.g. "B4") for Node codes with no explicit Node row yet.
model Category {
  id         String   @id @default(cuid())
  name       String   @unique
  nameEn     String?
  nameEt     String?
  nameLv     String?
  icon       String
  nodePrefix String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  nodes Node[]
}

// A specific Node code's identity (e.g. "B41" = "Кофе") and which category it
// belongs to. `Planogram.node` is matched against `Node.code` — kept as a plain
// string rather than a FK since imported Nodes may briefly have no Node row yet.
model Node {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  nameEn     String?
  nameEt     String?
  nameLv     String?
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt  DateTime @default(now())
}

model Planogram {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  node           String
  version        Int      @default(1)
  isCurrent      Boolean  @default(true)
  shelfLengthCm  Float    @default(133)
  // Some aisles route customer traffic right-to-left instead of the standard
  // left-to-right — flips how shelf contents render on screen (display only, never
  // the underlying rack/shelf/position data or instruction text). Lives per-planogram
  // rather than per-store since different Nodes in the same store can face either way.
  // Carried forward from the previous version whenever this Node is re-imported.
  mirrored       Boolean  @default(false)
  sourceFileName String
  importedAt     DateTime @default(now())
  importedById   String
  importedBy     User     @relation("ImportedBy", fields: [importedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  items PlanogramItem[]
  runs  PlanogramRun[]

  @@unique([storeId, node, version])
  @@index([storeId, node, isCurrent])
}

model PlanogramItem {
  id          String    @id @default(cuid())
  planogramId String
  planogram   Planogram @relation(fields: [planogramId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sortIndex   Int

  sap     String
  ean     String?
  article String

  rackOld             String
  shelfOld            String
  positionNumberOld   String
  facesOld            Int
  unitOrTrayOld       String?
  positionWidthOld    Float?
  productTrayWidthOld Float?

  rackNew             String
  shelfNew            String
  positionNumberNew   String
  facesNew            Int
  unitOrTrayNew       String?
  positionWidthNew    Float?
  productTrayWidthNew Float?

  faceWidth Float
  isNew     Boolean
  isDeleted Boolean

  feedbacks Feedback[]

  @@index([planogramId, sap])
}

model PlanogramRun {
  id              String    @id @default(cuid())
  planogramId     String
  planogram       Planogram @relation(fields: [planogramId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status          String    @default("NOT_STARTED")
  currentRealStep Int       @default(0)
  realStepsTotal  Int       @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  lastActivityAt  DateTime  @updatedAt
  createdAt       DateTime  @default(now())

  feedbacks Feedback[]

  @@index([planogramId, userId, status])
  @@index([userId, status])
}

model Feedback {
  id              String         @id @default(cuid())
  runId           String
  run             PlanogramRun   @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  planogramItemId String?
  planogramItem   PlanogramItem? @relation(fields: [planogramItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stepRealIndex   Int

  // structured reasons, matched to the app's feedback form checkboxes
  isShelfReady      Boolean?
  needSeparator     Boolean  @default(false)
  doesntFitByHeight Boolean  @default(false)
  doesntFitFacesQty Boolean  @default(false)
  otherReason       Boolean  @default(false)

  comment   String   @db.NVarChar(Max)
  userId    String
  user      User     @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime @default(now())

  // A planogram specialist's written reply back to the store, plus their
  // "acknowledged" checkbox — both set together whenever they respond.
  reply       String?   @db.NVarChar(Max)
  repliedById String?
  repliedBy   User?     @relation("FeedbackReplier", fields: [repliedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  repliedAt   DateTime?
  accepted    Boolean   @default(false)

  // The store's own "pay attention to this" marker — independent of the specialist's
  // reply, so a merchandiser can flag a row before anyone's replied to it.
  flaggedByStore Boolean @default(false)

  // The specialist's own marker — set when they need the store to check something or
  // clarify before a real reply can be given. Cleared automatically once they actually
  // reply or tick "accepted" (see the PATCH /api/feedback/[id] handler), so it never
  // lingers after the thing it was flagging for has been addressed.
  flaggedBySpecialist Boolean @default(false)

  // Flips true once the store has viewed a specialist's reply/acknowledgement/flag —
  // drives the "you got a reply" badge/banner without needing a separate read log.
  seenByStore Boolean @default(false)

  photos FeedbackPhoto[]

  @@index([runId])
}

// A feedback entry can carry several photos (the app lets you attach up to 3).
model FeedbackPhoto {
  id         String   @id @default(cuid())
  feedbackId String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  url        String
  createdAt  DateTime @default(now())

  @@index([feedbackId])
}

// One row per calendar month — a running total of characters sent to Azure Speech,
// so /api/tts can stop using the paid API once the free-tier budget for the month is
// used up and fall back to the browser's own (free, lower-quality) voice instead of
// silently starting to bill. Reset happens naturally: a new month just gets a new row.
model TtsUsage {
  id             String   @id @default(cuid())
  yearMonth      String   @unique // "2026-08"
  charactersUsed Int      @default(0)
  updatedAt      DateTime @updatedAt
}
