# Copy this to `.env` next to docker-compose.yml on the VPS (a SEPARATE file from
# your local dev .env — different host, different DB, different secrets).

DOMAIN=planograms.example.com

DB_NAME=PlanogramsDb
DB_USER=sa
DB_PASSWORD=change-me-to-a-strong-password

AUTH_SECRET=generate-with: npx auth secret
NEXTAUTH_URL=https://planograms.example.com

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# Optional — Azure AI Speech (Cognitive Services), for the run screen's voice
# assistant. Without these, it falls back to the browser's built-in TTS voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
