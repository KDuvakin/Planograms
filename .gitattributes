# Normalize line endings to LF in the repo regardless of the checkout platform's
# core.autocrlf setting, so Windows checkouts stop showing "LF will be replaced
# by CRLF" on every text file.
* text=auto eol=lf

# Binary files must never go through line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.xlsx binary
