DATABASE_URL="sqlserver://HOST:1433;database=PlanogramsDb;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=true"

DB_HOST="HOST"
DB_PORT="1433"
DB_NAME="PlanogramsDb"
DB_USER="USER"
DB_PASSWORD="PASSWORD"

AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"

# Optional — Azure AI Speech (Cognitive Services), for the run screen's voice
# assistant. Without these, it falls back to the browser's built-in TTS voice.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
# Once this many characters are sent to Azure in a calendar month, /api/tts stops
# calling it (falls back to the browser voice) instead of going over the free tier.
# Check your own Azure Speech resource's actual free-tier size before relying on 500000.
AZURE_TTS_MONTHLY_CHAR_LIMIT="500000"
